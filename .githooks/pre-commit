#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

echo "==> go build"
go build ./...

echo "==> go vet"
go vet ./...

echo "==> gofmt"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "gofmt: files need formatting:" >&2
  echo "$unformatted" >&2
  exit 1
fi

echo "==> go test -race"
go test ./... -race

if command -v golangci-lint >/dev/null 2>&1; then
  echo "==> golangci-lint"
  golangci-lint run
else
  echo "(skipping golangci-lint: not installed)" >&2
fi

if command -v govulncheck >/dev/null 2>&1; then
  echo "==> govulncheck"
  govulncheck ./...
else
  echo "(skipping govulncheck: not installed — install with: go install golang.org/x/vuln/cmd/govulncheck@latest)" >&2
fi

if command -v gitleaks >/dev/null 2>&1; then
  echo "==> gitleaks"
  gitleaks protect --staged --redact --verbose
else
  echo "(skipping gitleaks: not installed — see https://github.com/gitleaks/gitleaks#installing)" >&2
fi
